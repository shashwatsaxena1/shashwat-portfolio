    "lucide-react": "0.475.0",
    "next": "16.2.9",
    "next-themes": "0.4.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@types/node": "24.0.14",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.9",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.17",
