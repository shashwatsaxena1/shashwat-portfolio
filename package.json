{
  "name": "shashwat-premium-portfolio",
  "version": "1.0.3-node24-npm",
  "private": true,
  "description": "Premium editable developer portfolio built with Next.js App Router, TypeScript, Tailwind CSS, Framer Motion, and shadcn/ui-style components.",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
